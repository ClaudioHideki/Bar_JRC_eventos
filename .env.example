# ==============================================================================
# PASSAPORTE DE EVENTOS JRC - AMBIENTE DE CONFIGURAÇÃO (.env.example)
# NUNCA versione valores reais nem dados sensíveis.
# ==============================================================================

# Banco de Dados PostgreSQL Principal (interno Dokploy/Docker)
DATABASE_URL="postgresql://jrc_user:jrc_secure_password_change_me@postgres:5432/jrc_passaporte?schema=public"

# Banco de Dados PostgreSQL Isolado para Testes
DATABASE_TEST_URL="postgresql://jrc_test_user:jrc_test_pass@localhost:5433/jrc_passaporte_test?schema=public"

# Better Auth - Chave de criptografia de sessão e cookies (mínimo 32 caracteres)
BETTER_AUTH_SECRET="change_me_super_secret_better_auth_key_at_least_32_chars_long"
BETTER_AUTH_URL="http://localhost:3000"

# URL Pública da Aplicação
APP_URL="http://localhost:3000"

# Segredos HMAC exclusivos para tokens (mínimo 32 caracteres hexadecimais ou aleatórios)
INVITATION_TOKEN_SECRET="change_me_secret_for_invitations_must_be_different_from_others"
QR_TOKEN_SECRET="change_me_secret_for_qr_challenges_must_be_different_from_others"
RATE_LIMIT_SECRET="change_me_secret_for_rate_limiting_keys_must_be_different_from_others"

# Provedor SMTP / Mailgun para envio de OTPs
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@mg.jrc.com.br"
SMTP_PASSWORD="change_me_mailgun_smtp_password"
SMTP_FROM="Passaporte JRC <no-reply@jrc.com.br>"

# Fuso Horário da Aplicação
APP_TIMEZONE="America/Sao_Paulo"

# E-mail para Bootstrap do Primeiro Administrador (executado via comando CLI)
BOOTSTRAP_ADMIN_EMAIL="admin@jrc.com.br"

# Ambiente de Execução
NODE_ENV="development"
