# Conexão com o PostgreSQL (Interna no Dokploy)
DATABASE_URL="postgresql://jrc_user:sua_senha_forte@jrc-postgres:5432/jrc_passaporte?schema=public"

# URLs Oficiais do Sistema (Apontamento no Cloudflare)
APP_URL="https://passaporte.seudominio.com.br"
BETTER_AUTH_URL="https://passaporte.seudominio.com.br"

# Chaves Criptográficas de Segurança (32 bytes hex)
# Gere no terminal com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="substitua_por_32_bytes_hex_aleatorios"
INVITATION_TOKEN_SECRET="substitua_por_32_bytes_hex_aleatorios"
QR_TOKEN_SECRET="substitua_por_32_bytes_hex_aleatorios"
RATE_LIMIT_SECRET="substitua_por_32_bytes_hex_aleatorios"

# Ambiente e Fuso Horário
NODE_ENV="production"
APP_TIMEZONE="America/Sao_Paulo"
BOOTSTRAP_ADMIN_EMAIL="admin@jrc.com.br"

# Configuração SMTP (Opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Passaporte JRC <no-reply@jrc.com.br>"
