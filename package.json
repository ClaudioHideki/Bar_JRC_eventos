{
  "name": "site-passaporte-jrc",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema corporativo de passaporte digital de eventos para participantes convidados da JRC",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "db:backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:restore": "tsx scripts/restore.ts"
  },
  "overrides": {
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@yudiel/react-qr-scanner": "2.2.1",
    "better-auth": "1.7.2",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "16.3.4",
    "nodemailer": "10.0.0",
    "pg": "8.13.3",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.13.4",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.11",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prettier": "3.5.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "6.4.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
